# Supabase project URL used by browser and server clients.
NEXT_PUBLIC_SUPABASE_URL=
# Supabase anonymous public key used by browser and server clients.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Supabase service role key for trusted server scripts and webhooks only.
SUPABASE_SERVICE_ROLE_KEY=

# Supabase Postgres connection strings used by Auth.js and Drizzle.
# DATABASE_URL should be the Supabase pooler URL on port 6543 with pgbouncer=true.
# DIRECT_URL should be the direct database URL for migrations.
DATABASE_URL=
DIRECT_URL=

# Auth.js configuration.
AUTH_SECRET=
AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
MICROSOFT_ENTRA_ID_CLIENT_ID=
MICROSOFT_ENTRA_ID_CLIENT_SECRET=
MICROSOFT_ENTRA_ID_TENANT_ID=common
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Inputs for `pnpm apple:secret`. The generated value becomes APPLE_CLIENT_SECRET.
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_PATH=
# APPLE_PRIVATE_KEY can be used instead of APPLE_PRIVATE_KEY_PATH. Escape newlines as \n.
APPLE_PRIVATE_KEY=

# Stripe secret key for server-side billing operations.
STRIPE_SECRET_KEY=
# Stripe webhook signing secret.
STRIPE_WEBHOOK_SECRET=
# Stripe publishable key for browser display flows.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Stripe price IDs, filled in after running `pnpm seed:stripe`.
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_STARTER_ANNUAL=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_ANNUAL=
STRIPE_PRICE_BUSINESS_MONTHLY=
STRIPE_PRICE_BUSINESS_ANNUAL=
STRIPE_PRICE_LEGAL_MONTHLY=
STRIPE_PRICE_LEGAL_ANNUAL=

# Public site origin for redirects.
NEXT_PUBLIC_SITE_URL=https://eclipsesystems.pro
# Resend API key for transactional email stubs.
RESEND_API_KEY=
# Demo booking notifications. Separate multiple recipients with commas.
DEMO_NOTIFICATION_EMAILS=garrett@eclipsesystems.pro,john@eclipsesystems.pro
# Must use a sender/domain verified in Resend.
DEMO_NOTIFICATION_FROM="Eclipse Systems <bookings@eclipsesystems.pro>"
