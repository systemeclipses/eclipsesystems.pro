{
  "name": "eclipsesystems-timekeeping",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "pnpm --filter @eclipsesystems/web dev",
    "build": "pnpm --filter @eclipsesystems/web build",
    "lint": "pnpm --filter @eclipsesystems/web lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @eclipsesystems/web test:e2e",
    "seed:stripe": "tsx scripts/seed-stripe.ts",
    "supabase:reset": "supabase db reset",
    "supabase:test": "supabase test db"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "tsx": "4.19.2",
    "typescript": "5.7.2"
  }
}
