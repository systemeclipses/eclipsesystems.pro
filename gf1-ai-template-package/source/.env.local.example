# Supabase project configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
PROPOSAL_PRICING_SECRET=replace-with-32-byte-secret

# Optional: comma-separated admin email allowlist
ADMIN_EMAILS=ops@galactic-inc.com

# Optional: public app URL for links in emails
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: Brevo transactional email integration
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Galactic Team
SUPPORT_ADMIN_EMAIL=no-reply@galactic-inc.com

# Google Gemini API key (used for receipt auto-fill on the expenses page)
# Get one free at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
